{
  "name": "code-reviewer",
  "version": "1.1.0",
  "description": "Desktop app for reviewing local git changes with inline comments, threaded follow-ups, and reviews that survive a rebase",
  "main": "main.js",
  "author": "Dheeraj Jha",
  "license": "MIT",
  "homepage": "https://github.com/dheerajjha/reviewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dheerajjha/reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/dheerajjha/reviewer/issues"
  },
  "keywords": [
    "code-review",
    "git",
    "diff",
    "electron",
    "desktop",
    "review",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "electron": "electron .",
    "electron:dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dheerajjha.codereview",
    "productName": "Code Reviewer",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "icon": "resources/icon.icns"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "resources/icon.png"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
