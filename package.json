{
  "name": "code-reviewer",
  "version": "2.0.0",
  "description": "Review local git changes in your browser with inline comments and threaded follow-ups — no branch, remote, or account required",
  "author": "Dheeraj Jha",
  "license": "MIT",
  "homepage": "https://github.com/dheerajjha/reviewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dheerajjha/reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/dheerajjha/reviewer/issues"
  },
  "keywords": [
    "code-review",
    "git",
    "diff",
    "review",
    "cli",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "server.js",
  "bin": {
    "reviewer": "bin/reviewer.js"
  },
  "files": [
    "bin/",
    "lib/",
    "public/",
    "server.js"
  ],
  "scripts": {
    "start": "node bin/reviewer.js",
    "serve": "node server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "simple-git": "^3.20.0"
  }
}
